# npm's built-in install safeguards. These apply to every install: locally, in
# GitHub CI and on Netlify.

# Fail the install if a dependency has install scripts (preinstall, install,
# postinstall) that aren't approved under "allowScripts" in package.json.
# Without this, npm 11 only prints a notice and runs them anyway. Install
# scripts are how most npm supply-chain attacks run their code.
strict-allow-scripts=true

# Only install versions that were published at least 7 days ago. Malicious
# releases are usually spotted and pulled from npm within that window, so
# they never reach this project.
min-release-age=7
