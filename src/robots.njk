---
permalink: '/robots.txt'
hidden: true
eleventyExcludeFromCollections: true
---
# www.robotstxt.org
# Ref: https://yoast.com/ultimate-guide-robots-txt/

{% if site.robotsCrawl -%}
# ALLOW crawling of all content except for certain user-agents, directories / pages etc. and their contents eg. `/foo`
# == Open the doors to all other user-agents in Production ==
{#- The one exception is the honeypot page (`src/_content/pages/honeypot.md`). Well-behaved crawlers read this
    and stay away, so the only crawlers that end up there (and get blocked by `netlify/edge-functions/aiAgents.js`)
    are ones that ignore robots.txt. `/honeypot` also covers `/honeypot/` and `/honeypot.html`, as robots.txt
    rules match the start of an address. #}
User-agent: *
Disallow: /honeypot

{% else -%}
# DISALLOW crawling of all content
# == Handy during beta testing ==
User-agent: *
Disallow: /
{%- endif -%}

{%- if site.aiCrawl == false -%}
# AI training / answer synthesis agents
{#- Loops through global `_data` file called `ai_agents.json` #}
{% for agent in ai_agents %}
User-agent: {{ agent }}
Disallow: /
{% endfor %}
{% endif -%}

# Sitemap location
Sitemap: {{ site.rootUrl }}/sitemap.xml
