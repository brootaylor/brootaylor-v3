<section aria-label="Featured articles" class="wrapper | flow | collection collection--featured">

	<h2>Featured articles</h2>
	<ol class="collection__list">
		{#
			`asyncEach` rather than `for`: a card can include a video (`components/core/videos/videos.njk`),
			which uses the async `{% video %}` shortcode. Inside a `{% for %}` loop that silently outputs nothing.
		#}
		{% asyncEach component in collections.featured %}
			<li class="collection__item">
				{# This component pulls the front matter from the featured collection data in "_content/collections/featured" #}
				{% include "components/units/card/card.njk" %}
			</li>
		{% endeach %}
	</ol>

</section>
