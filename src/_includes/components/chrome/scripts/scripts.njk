{#
	Vendor / 3rd Party JS
	**********************
	Only render this code snippet if `scriptsMain` and `scriptsVendor` are `true` in `_data/site.js`
#}
{% if site.scriptsMain and site.scriptsVendor %}
	<script src="/scripts/vendor/vendor.js?version={{ pkg.version }}.{{ site.timeCurrent }}"></script>
{% endif %}

{#
	Main JS
	**********
	Only render this code snippet if `scriptsMain` is `true` in `_data/site.js`
#}
{% if site.scriptsMain %}
	{# Native JS module (ESM). Module scripts are deferred by default, so this doesn't block the page from rendering.
	   There's no fallback script for browsers without module support (eg. Opera Mini and KaiOS 2.5, which are still in
	   `.browserslistrc`). They get the page without these extras, which still works: the JS only adds enhancements. #}
	<script type="module" src="/scripts/modules/main.mjs?version={{ pkg.version }}.{{ site.timeCurrent }}"></script>
{% endif %}

{# Generates extra page-specific JS eg. 3rd party scripts like Greensocks or custom JS functions #}
{#
	NOTE: Inline `<script>` blocks added through `foot` work: the build allows each one in the Content Security
	Policy by its hash (see `lib/utils/headers/contentSecurityPolicy.js`). Scripts from other sites are still
	blocked unless their address is added to `script-src` there.
#}
{% if foot %}
	<!-- Extra page-specific JS eg. 3rd party scripts like Greensocks or custom JS functions -->
	{{ foot | safe }}
{% endif %}
