{# These variables are set here to pull from the global `site.json` file #}
{% set metaTitle = site.metaTitle %}
{% set metaDescription = site.metaDescription %}
{% set metaImage = site.metaImage %}
{% set metaImageAlt = site.metaImageAlt %}
{% set rootUrl = site.rootUrl %}

{# Page-specific social media variables #}
{% set socialImageUrl = socialImage.url %}
{% set socialImageAlt = socialImage.alt %}

{# This 'hidden' variable is used to exclude pages from an Eleventy collection as well as being indexed by search engines #}
{% set hidden = (hidden == true or eleventyExcludeFromCollections == true) %}

{#
	-> Setting page level content variables
#}
{# Check whether `title` value exists first... #}
{% if title %}
	{# And then whether it's the `homepage`... #}
	{% if bodyClass == 'homepage' %}
		{% set pageTitle = metaTitle %}
	{% else %}
		{% set pageTitle = title + ' • ' + metaDescription %}
	{% endif %}
{% else %}
	{% set pageTitle = metaTitle %}
{% endif %}

{# Check whether `summary` value exists first... #}
{% if summary %}
  {% set metaDescription = summary %}
{% endif %}


<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{# Declares that the site has light and dark colour schemes, matching `color-scheme` in `styles/base/_reset.scss`.
   It comes early so the browser can use the right background before the CSS has loaded (less of a white flash).
   `light dark` means "follow the device setting". It's also where a visitor's own choice ends up (`light` or `dark`):
   the CSS in `_reset.scss` reads this tag back. #}
<meta name="color-scheme" content="light dark">
{#
	Applies a visitor's saved colour scheme (Light or Dark) before the page is drawn, so there's no flash of the
	wrong colours. It has to be a plain inline script, straight after the `<meta>`: a module or deferred script
	can run after the first paint.
	- It only copies a saved `light` or `dark` into the `<meta>` above. Everything else (the controls, saving the
	  choice) is in `scripts/features/colourScheme.mjs`, which also re-applies the saved value as a backup.
	- `try`/`catch`: reading `localStorage` can throw when site data is blocked. The site then follows the device.
	- The CSP only allows this script by its `'sha256-…'` hash. The build works that out from the finished page, so
	  editing `colour-scheme-init.js` needs nothing else (see `lib/utils/headers/contentSecurityPolicy.js`).
	- Only included when visitors can choose (`colourSchemeChoice` and `scriptsMain` in `_data/site.js`). Otherwise a
	  choice saved earlier would stick, with no control left to change it.
#}
{% if site.colourSchemeChoice and site.scriptsMain %}
<script>{% include "components/chrome/meta/colour-scheme-init.js" %}</script>
{% endif %}
<title>{{ pageTitle | safe }}</title>
<meta name="description" content="{{ metaDescription }}">

{# Checking whether page is to be indexed or not --> ie. whether `hidden` variable equals `true` or `false` #}
<meta name="robots" content="{% if hidden %}noindex, nosnippet{% else %}index{% endif %}, follow">

{# Displaying the build number / version #}
<meta name="build" content="{{ pkg.version }}.{{ site.timeCurrent }}">

{# Displaying the version of Eleventy used to generate this website #}
<meta name="generator" content="{{ eleventy.generator }}">

{# Styles. `assetVersion` is a fingerprint of the built CSS and JS (see `src/_data/assetVersion.js`), so the
   address only changes when the files do, and returning visitors otherwise keep using their copy. #}
<link rel="stylesheet" href="/styles/main.css?version={{ assetVersion }}">

{# Generates extra page-specific <head> metadata fields eg. styles, fonts & custom preload/prefetch #}
{% if head %}
	<!-- Extra page-specific metadata fields & rules eg. styles, fonts, SVGs & custom preload/prefetch -->
	{{ head | safe }}
{% endif %}

{# Canonical #}
{% if hidden != true %}
	<link rel="canonical" href="{{ rootUrl }}{{ page.url | pretty }}">
{% endif %}

{# Author 'humans' document #}
<link rel="author" href="{{ rootUrl }}/humans.txt">

{# Feed. It's an Atom feed (see `src/feed.njk`), so the type says Atom rather than RSS. Feed readers use this
   to find the feed when someone subscribes with just the site's address. #}
<link rel="alternate" type="application/atom+xml" href="{{ rootUrl }}/feed.xml" title="{{ metaTitle }}">

{# Open graph #}
{% if hidden != true %}
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="{{ site.name }}">
	<meta property="og:title" content="{{ pageTitle }}">
	<meta property="og:description" content="{{ metaDescription }}">
	<meta property="og:url" content="{{ rootUrl }}{{ page.url | pretty }}">
	<meta property="og:image" content="{{ rootUrl }}{% if socialImageUrl %}{{ socialImageUrl }}{% else %}{{ metaImage }}{% endif %}">
	<meta property="og:image:alt" content="{% if socialImageAlt %}{{ socialImageAlt | imageAlt }}{% else %}{{ metaImageAlt | imageAlt }}{% endif %}">
{% endif %}

{#
	Twitter...
	Only render this code snippet if `twitter` has a handler value in `_data/site.js`
	There's no `twitter:url` tag: cards don't use one (they take the address from `og:url` above).
#}
{% if site.twitter and hidden != true %}
	<meta name="twitter:card" content="summary">
	<meta name="twitter:site" content="{{ site.twitter }}">
	<meta name="twitter:title" content="{{ pageTitle }}">
	<meta name="twitter:description" content="{{ metaDescription }}">
	<meta name="twitter:image" content="{{ rootUrl }}{% if socialImageUrl %}{{ socialImageUrl }}{% else %}{{ metaImage }}{% endif %}">
	<meta name="twitter:image:alt"  content="{% if socialImageAlt %}{{ socialImageAlt | imageAlt }}{% else %}{{ metaImageAlt | imageAlt }}{% endif %}">
{% endif %}

{# Favicons, icons and manifests.
   There are no `msapplication-*` tags or `browserconfig.xml`: they were only for Start-screen tiles in Internet
   Explorer and old Edge, which the site no longer supports (see `.browserslistrc`). #}
<link rel="apple-touch-icon" sizes="180x180" href="{{ site.icon | url }}">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/ico/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/ico/favicon-16x16.png">
<link rel="mask-icon" href="/assets/ico/safari-pinned-tab.svg" color="{{ site.theme_color_ios }}">
<link rel="shortcut icon" href="{{ site.favicon | url }}">
<link rel="manifest" href="/manifest.json">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="{{ site.short_name }}">
<meta name="theme-color" content="{{ site.theme_color_android }}">

{#
	Preconnect / dns-prefect stuff...
	@NOTE: Only render this code snippet if `analyticsUrchin` has a value in `_data/site.js`
#}
{% if site.analyticsUrchin %}
	<link rel="preconnect" href="https://www.googletagmanager.com/" crossorigin>
	<link rel="dns-prefetch" href="https://www.googletagmanager.com/">
	<link rel="preconnect" href="https://www.google-analytics.com/" crossorigin>
	<link rel="dns-prefetch" href="https://www.google-analytics.com/">
{% endif %}
