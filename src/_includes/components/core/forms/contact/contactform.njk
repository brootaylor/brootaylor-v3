{# Setting contact form component content. (Pulls from global `contactform.js` data file) #}
{% set botMessage = contactform.botMessage %}

{# Form Legend #}
{% set legend = contactform.legend %}

{# Visible note that every field is required #}
{% set requiredNote = contactform.requiredNote %}

{# Form labels... #}
{% set labelName = contactform.labelName %}
{% set labelEmail = contactform.labelEmail %}
{% set labelSubject = contactform.labelSubject %}
{% set labelMessage = contactform.message.label %}
{% set labelButton = contactform.labelButton %}

{# Message form field... #}
{% set messagePlaceholder = contactform.message.placeholder %}


<form class="form" method="post" name="contact" action="/contact/thanks" netlify-honeypot="bot-field" data-netlify="true">

	{# This is to trick bots and prevent spam emails being submitted #}
	<p class="hidden">
		<label>{{ botMessage }} <input name="bot-field"></label>
	</p>

	{# Fields that need filling out #}
	<fieldset class="form__group">
		<legend class="visually-hidden">{{ legend }}</legend>

		{# Visible note, so sighted visitors know every field is required #}
		<p>{{ requiredNote }}</p>

		{#
			`autocomplete` lets browsers and password managers fill in the visitor's own name and email.
			WCAG 1.3.5 (Identify Input Purpose) asks for it on fields that collect details about the visitor.
			On the email field, `autocapitalize="none"` and `spellcheck="false"` stop phones capitalising or
			"correcting" the address as it's typed.
		#}
		<ol role="list" class="form__list | no-list">
			<li class="form__item">
				<label class="form__label" for="name">{{ labelName }} <small class="visually-hidden">(required field)</small></label>
				<input class="form__input" id="name" name="name" type="text" autocomplete="name" required>
			</li>
			<li class="form__item">
				<label class="form__label" for="email">{{ labelEmail }} <small class="visually-hidden">(required field)</small></label>
				<input class="form__input" id="email" name="email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" required>
			</li>
			{# Can be filled in from the address (`?subject=`) when a writing post links here, by
			   `scripts/components/contactSubject.mjs`. Otherwise it starts empty. #}
			<li class="form__item">
				<label class="form__label" for="subject">{{ labelSubject }} <small class="visually-hidden">(required field)</small></label>
				<input class="form__input" id="subject" name="subject" type="text" required>
			</li>
			<li class="form__item">
				<label class="form__label" for="message">{{ labelMessage }} <small class="visually-hidden">(required field)</small></label>
				<textarea class="form__input" id="message" name="message" placeholder="{{ messagePlaceholder }}" required></textarea>
			</li>
		</ol>

		{# Submit button #}
		{% from "components/core/buttons/buttons.njk" import button %}
		{{ button('button', 'button--primary', false, labelButton) }}

	</fieldset>

</form>
