{#
	Card component
	=======================
	Usually has an image / video, title, text and CTA
#}
<article class="card {{ component.data.modifier }}">

	{# Only render this visual element if there's either an image or video (an image wins if there are both) #}
	{% if component.data.hasImage %}
		<div class="card__visual">
			{% include "components/core/images/images.njk" %}
		</div>
	{% endif %}
	{#
		`ifAsync`, and a separate block rather than an `elif`: the video include can use the async `{% video %}`
		shortcode, and inside a plain `{% if %}` (or an `elif`, even of `ifAsync`) its output is silently dropped.
	#}
	{% ifAsync component.data.hasVideo and not component.data.hasImage %}
		<div class="card__visual">
			{% include "components/core/videos/videos.njk" %}
		</div>
	{% endif %}

	{# Using the `.flow` utility class to handle child element spacing #}
	<div class="card__content | flow">
		<header class="card__header">
				<h3 class="card__title">{{ component.data.title }}</h3>
		</header>
		<div class="card__body">
			<p>{{ component.data.body }}</p>
		</div>

		{# Check if there's a CTA #}
		{% if component.data.hasCta %}
			{% include "components/core/buttons/buttons.njk" %}
		{% endif %}
	</div>

</article>
