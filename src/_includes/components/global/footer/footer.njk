{# A `<footer>` that sits directly in `<body>` is already the "contentinfo" landmark, so it doesn't need `role="contentinfo"` #}
<footer id="footer" class="site-footer">
	<div class="wrapper">

		{# Hidden heading, so screen reader users can also reach the footer by jumping between headings #}
		<h2 class="visually-hidden">Site information and links</h2>
		<small>&copy; 2004 &ndash; <time datetime="{% year %}">{% year %}</time> {{ site.name }}. All rights reserved.</small>

		{#
			Pulls content from navigation.json data file
			`aria-label="Footer"` tells this navigation landmark apart from the "Primary" one in the header.
			Screen readers add the word "navigation" themselves, so the label doesn't repeat it.
		#}
		<nav aria-label="Footer">

			{# Hidden heading, so screen reader users can also reach these links by jumping between headings #}
			<h2 class="visually-hidden">Footer navigation</h2>

			{% for navitem in navigation.footernav %}
				{% if loop.first %}<ul role="list" class="no-list">{% endif %}
					<li>
						<a href="{{ navitem.url }}"
							{% if navitem.delete %} title="{{ navitem.delete.label }}"{% endif %}
							{% if navitem.external %} rel="external{% if navitem.verified %} me{% endif %}"{% endif %}
							{% if (page.url | pretty) == navitem.url %} aria-current="page"{% endif %}>
							{% if navitem.icon %}
								<span class="visually-hidden">{{ navitem.label }}</span>
								{#- The "x" data value doesn't have a matching icon--x.njk file (still named
								   icon--twitter.njk from before the rebrand) - map it explicitly so this
								   dynamic include doesn't break if/when that nav item is re-enabled. -#}
								{% set iconFile = "twitter" if navitem.icon == "x" else navitem.icon %}
								{% include "components/core/icons/svg_inline/icon--" + iconFile + ".njk" %}
							{% else %}
								{{ navitem.label }}
							{% endif %}
						</a>
					</li>
				{# Looping through list items ends here #}
				{% if loop.last %}
					{# These (below) are static list items and don't belong to the loop (above)...  #}
					<li>
						<a href="/blogroll" {% if (page.url | pretty) == '/blogroll' %} aria-current="page"{% endif %}>Blogroll</a>
					</li>
					<li>
						<a href="/privacy" {% if (page.url | pretty) == '/privacy' %} aria-current="page"{% endif %}>Privacy</a>
					</li>
					<li>
						<a href="/accessibility" {% if (page.url | pretty) == '/accessibility' %} aria-current="page"{% endif %}>Accessibility</a>
					</li>
					<li>
						{# Back to the top link / anchor #}
						<a href="#start">Back to top <i aria-hidden="true">&uarr;</i></a>
					</li>
				</ul>
				{% endif %}
			{% endfor %}
		</nav>

		{# Light / Dark / System choice (hidden until `scripts/features/colourScheme.mjs` shows it).
		   Switched on with `colourSchemeChoice` (and `scriptsMain`) in `_data/site.js`. #}
		{% if site.colourSchemeChoice and site.scriptsMain %}
			{% from "components/units/colour-scheme/colour-scheme.njk" import colourSchemeControl %}
			{{ colourSchemeControl("footer") }}
		{% endif %}

	</div>

</footer>
