{#
	`aria-label="Primary"` names this navigation landmark. Screen readers add the word "navigation" themselves
	("Primary, navigation"), so the label doesn't repeat it.
#}
<nav aria-label="Primary" class="navigation">

	{# Hidden heading, so screen reader users can also reach the navigation by jumping between headings #}
	<h2 class="visually-hidden">Primary navigation</h2>

	{#
		`aria-current` marks where the visitor is:
		- `"page"` on the link to the exact page being viewed (eg. "Notes" on /notes)
		- `"true"` on the link to the section the page belongs to (eg. "Notes" on a single note under /notes/...)
		Both get the same "current" styling (see `_navigation.scss`).
	#}
	{% set currentUrl = page.url | pretty %}

	{# Pulls content from navigation.json data file #}
	{% for navitem in navigation.mainnav %}
		{% if loop.first %}<ul role="list" class="navigation__list | no-list">{% endif %}
			<li class="navigation__item">
				<a href="{{ navitem.url }}"
					{%- if currentUrl == navitem.url %} aria-current="page"
					{%- elif (navitem.url + '/') in currentUrl %} aria-current="true"{% endif %}>{{ navitem.label }}</a>
			</li>
		{% if loop.last %}</ul>{% endif %}
	{% endfor %}

</nav>
