{#- This file is a Nunjucks template that Eleventy renders to `/serviceworker.js`.
    `eleventyExcludeFromCollections: true` keeps it out of Eleventy's page/post
    collections since it's the site's Service Worker script, not a real page. -#}

/*
 * {{ pkg.name }}
 * v{{ pkg.version }}
 * {{ pkg.homepage }}
 * Copyright (c) {% year %} {{ pkg.author.name }}. Licensed {{ pkg.license }}
 */
{#
	There's deliberately no "last generated" date in this file. Browsers check for a new service worker by
	comparing this file byte for byte, so a date here would make it "new" after every daily build, and every
	visitor's service worker would reinstall and re-download its offline pages, even when nothing had changed.

	`pkg.version` and `assetVersion` are injected at build time. `assetVersion` is a fingerprint of the built
	CSS and JS (see `src/_data/assetVersion.js`), so `cacheName` only changes when they do (or when the package
	version is bumped). Then `clearOldCaches()` (see below) sweeps away the old caches on `activate`, cached
	pages included, so offline pages are never left pointing at a stylesheet that's no longer cached.
	When only the content changes (eg. a new post), the cache names stay the same: the updated service worker
	downloads its offline pages again into the same caches (so they're current), and everything else that's
	already cached (eg. images and scripts) is kept.

	What's saved: the stylesheet and offline pages when the service worker installs, the site's scripts at the
	same time (see `staticScripts`), and pages and images as they're visited. The static cache stays small:
	it's replaced whenever `assetVersion` changes, and in between, `tidyStaticCache()` removes anything that's
	dropped off this build's lists (eg. a post that's no longer one of the latest five) on `activate`. Visited
	pages and images are kept to `maxPages` and `maxImages` by `trimCache()`.
#}
// Define cache names and version information
const siteName = '{{ pkg.name }}';
const siteVersion = 'v{{ pkg.version }}';
const assetVersion = '{{ assetVersion }}';
const cacheName = siteName + '_' + siteVersion + '.' + assetVersion;

// Set cache limits and timeout
const maxPages = 50; // Maximum number of pages to cache
const maxImages = 100; // Maximum number of images to cache
const timeout = 3000; // Number of milliseconds before timing out

// Define specific cache names for different types of content
const staticCacheName = 'static@' + cacheName;
const pagesCacheName = 'pages@' + cacheName;
const imagesCacheName = 'images@' + cacheName;
const cacheList = [
    staticCacheName,
    pagesCacheName,
    imagesCacheName
];

// Used as a fallback when `request.destination` isn't set
const imagePattern = /\.(jpe?g|webp|avif|png|gif|svg)$/i;

// Define the offline page URL
const offlinePage = '/offline';
{# Builds the list of URLs to pre-cache for offline use: the 5 most recent
   posts, internal main/footer nav links (excluding ones flagged `document`
   or `external`), all `page`-tagged pages, and the site's start_url. The
   `pretty` filter (lib/utils/filters/pretty-url.js) strips `(index).html`
   so cached URLs match the real permalinks the site actually serves. #}
// Define pages to be available offline
// This list is populated dynamically based on your site structure
const offlinePages = [
{#- Loops through all `post` tagged posts -#}
{%- set allPosts = collections.post | reverse -%}
{#- Returns a maximum of 5 `post` tagged posts. -#}
{% for item in allPosts.slice(0, 5) %}
    '{{ item.url | pretty }}',
{%- endfor %}
{#- Loops through the `mainnav` object in `_data/navigation.js` -#}
{%- for item in navigation.mainnav %}
    {#- Doesn't show a URL if marked as `document` or `external` -#}
    {%- if (item.document !== true) and (item.external !== true) %}
    '{{ item.url }}',
    {%- endif -%}
{%- endfor -%}
{#- Loops through the `footernav` object in `_data/navigation.js` -#}
{% for item in navigation.footernav %}
    {#- Doesn't show a URL if marked as `document` or `external` -#}
    {%- if (item.document !== true) and (item.external !== true) %}
    '{{ item.url }}',
    {%- endif -%}
{%- endfor %}
{#- Loops through all `page` tagged pages -#}
{%- set allPages = collections.page -%}
{#- Returns `page` tagged pages. -#}
{% for item in allPages | reverse %}
    '{{ item.url | pretty }}',
{%- endfor %}
    '{{ site.start_url }}'
];

// Define non-mandatory static assets
// These assets are cached but won't block service worker installation if they fail to cache
const staticNonMandatory = [
    '/assets/images/common/logo-social.png'
];
{# `main.css`'s `?version=` uses the same `assetVersion` fingerprint as
   `cacheName` above, and must match the address the pages use (see
   `components/chrome/meta/meta.njk`), so this SW caches the CSS the pages ask for. #}
// Define mandatory static assets
// These assets must be cached for the service worker to complete installation
const staticMandatory = [
    '/styles/main.css?version={{ assetVersion }}',
    offlinePage
];
{#
	The site's JavaScript, saved when the service worker installs, so it's served straight from the cache
	(no network request) and still works offline. The addresses must match exactly what the pages request:
	`main.mjs` (and `vendor.js`) with the same `?version=` as `components/chrome/scripts/scripts.njk`, and the
	extra files `main.mjs` loads with `import()` by their hash-named file names (`src/_data/scriptChunks.js`).
	The same `site.*` settings as `scripts.njk` decide which ones exist.
	They're non-mandatory: the JS only adds enhancements, so the service worker still installs (and offline
	pages still work, just without those extras) if they can't be saved.
#}
// Define the site's scripts (non-mandatory, cached separately - see `updateStaticCache()`)
const staticScripts = [
{%- if site.scriptsMain %}
    '/scripts/modules/main.mjs?version={{ assetVersion }}',
    {%- for chunk in scriptChunks %}
    '{{ chunk }}',
    {%- endfor %}
    {%- if site.scriptsVendor %}
    '/scripts/vendor/vendor.js?version={{ assetVersion }}',
    {%- endif %}
{%- endif %}
];

/**
 * Updates the static cache with mandatory and non-mandatory items
 * @returns {Promise} A promise that resolves when caching is complete
 */
function updateStaticCache() {
    return caches.open(staticCacheName)
    .then(staticCache => {
        // These items won't block the installation of the Service Worker
        staticCache.addAll([...offlinePages, ...staticNonMandatory])
        .catch(error => {
            console.error('Failed to cache non-mandatory assets:', error);
        });
        // The scripts are saved in a batch of their own. `addAll()` is all-or-nothing, so if they shared the
        // batch above, one script that couldn't be fetched would stop every offline page being saved too.
        // Like that batch, it doesn't block installation.
        if (staticScripts.length) {
            staticCache.addAll(staticScripts)
            .catch(error => {
                console.error('Failed to cache scripts:', error);
            });
        }
        // These items MUST be cached for the Service Worker to complete installation
        return staticCache.addAll(
            staticMandatory
        );
    });
}

/**
 * Caches the pages that initiate the service worker
 * @returns {Promise} A promise that resolves when client pages are cached
 */
function cacheClients() {
    const pages = [];
    return clients.matchAll({
        includeUncontrolled: true
    })
    .then(allClients => {
        for (const client of allClients) {
            pages.push(client.url);
        }
    })
    .then(() => {
        return caches.open(pagesCacheName)
        .then(pagesCache => {
            return pagesCache.addAll(pages);
        })
        .catch(error => {
            console.error('Failed to cache client pages:', error);
        });
    });
}

/**
 * Removes caches whose name is no longer valid
 * @returns {Promise} A promise that resolves when old caches are cleared
 */
function clearOldCaches() {
    return caches.keys()
    .then(keys => {
        return Promise.all(keys
            .filter(key => !cacheList.includes(key))
            .map(key => caches.delete(key))
        );
    });
}

/**
 * Removes anything from the static cache that's no longer on this build's lists.
 * When only the content changes (eg. a new post), the cache names stay the same, so without this, offline
 * pages that drop off the list (eg. a post that's no longer one of the latest five) would stay saved until the
 * CSS or JS next changed. Anything still being saved by `updateStaticCache()` is on the lists, so it's kept.
 * @returns {Promise} A promise that resolves when the static cache has been tidied
 */
function tidyStaticCache() {
    // The lists hold paths (eg. `/about`); the cache holds full addresses, so compare those
    const currentFiles = new Set(
        [...staticMandatory, ...staticNonMandatory, ...offlinePages, ...staticScripts]
        .map(path => new URL(path, location.origin).href)
    );
    return caches.open(staticCacheName)
    .then(staticCache => {
        return staticCache.keys()
        .then(requests => {
            return Promise.all(requests
                .filter(request => !currentFiles.has(request.url))
                .map(request => staticCache.delete(request))
            );
        });
    });
}

/**
 * Trims the cache to the specified maximum number of items
 * @param {string} cacheName - The name of the cache to trim
 * @param {number} maxItems - The maximum number of items to keep in the cache
 * @returns {Promise} A promise that resolves when trimming is complete
 */
function trimCache(cacheName, maxItems) {
    return caches.open(cacheName)
    .then(cache => {
        return cache.keys()
        .then(keys => {
            const excess = keys.length - maxItems;
            if (excess <= 0) return; // Early return if no trimming is needed
            // cache.keys() returns items in insertion order, so the oldest
            // `excess` entries are at the start of the array
            return Promise.all(
                keys.slice(0, excess).map(key => cache.delete(key))
            );
        });
    });
}

/**
 * Adds a request/response pair to the specified cache and trims if necessary
 * @param {string} cacheName - The name of the cache to add to
 * @param {Request} request - The request object
 * @param {Response} response - The response object
 * @returns {Promise} A promise that resolves when the item is cached and the cache trimmed
 */
function addToCache(cacheName, request, response) {
    return caches.open(cacheName)
    .then(cache => {
        return cache.put(request, response);
    })
    .then(() => {
        return trimCache(cacheName, cacheName === imagesCacheName ? maxImages : maxPages);
    });
}

// Service Worker install event
addEventListener('install', event => {
    event.waitUntil(
        updateStaticCache()
        .then(() => {
            return cacheClients();
        })
        .then(() => {
            return self.skipWaiting();
        })
        .catch(error => {
            console.error('Service Worker installation failed:', error);
            // Let any open pages know, so they can show a user-friendly message
            // (see the `message` listener in `src/scripts/features/serviceWorker.mjs`)
            self.clients.matchAll({ includeUncontrolled: true }).then(clients => {
                clients.forEach(client => {
                    client.postMessage({
                        type: 'installFailed',
                        message: 'We\'re having trouble setting up offline functionality. Some features may not work offline.'
                    });
                });
            });
            throw error; // Rethrow to prevent installation
        })
    );
});

// Service Worker activate event
addEventListener('activate', event => {
    event.waitUntil(
        clearOldCaches()
        .then(() => {
            // Housekeeping only, so a failure is logged rather than stopping the steps below
            return tidyStaticCache()
            .catch(error => {
                console.error('Failed to tidy the static cache:', error);
            });
        })
        .then(() => {
            // Enable navigation preload if available
            if (self.registration.navigationPreload) {
                return self.registration.navigationPreload.enable();
            }
        })
        .then(() => {
            return self.clients.claim();
        })
    );
});

// Service Worker message event
addEventListener('message', event => {
    if (event.data && event.data.command === 'trimCaches') {
        event.waitUntil(
            Promise.all([
                trimCache(pagesCacheName, maxPages),
                trimCache(imagesCacheName, maxImages)
            ]).catch(error => {
                console.error('Failed to trim caches:', error);
            })
        );
    }
});

// Fetch event listener
addEventListener('fetch', event => {
    const request = event.request;
    const url = new URL(request.url);

    // Ignore non-GET requests
    if (request.method !== 'GET') {
        return;
    }

    // Ignore cross-origin requests (CDNs, analytics, embeds etc.) and let the
    // browser handle them as normal. Their responses are usually "opaque",
    // which can't be checked for errors and use up a lot of storage quota.
    if (url.origin !== location.origin) {
        return;
    }

    const isImage = request.destination === 'image' || imagePattern.test(url.pathname);

    // For HTML requests, try the network first, fall back to the cache, finally the offline page
    if (request.mode === 'navigate' || request.headers.get('Accept')?.includes('text/html')) {
        const retrieveFromCache = caches.match(request);

        // Reuse the navigation preload fetch the browser already started (see the
        // `activate` listener) instead of issuing a second one; it resolves to
        // `undefined` if the browser opted not to preload this navigation.
        const preloadResponse = event.preloadResponse
            ? event.preloadResponse.catch(preloadError => {
                console.error(preloadError);
                return undefined;
            })
            : Promise.resolve(undefined);

        const networkResponse = preloadResponse.then(responseFromPreload => {
            return responseFromPreload || fetch(request);
        });

        // Stash a copy of successful pages in the pages cache. Passing this to
        // `waitUntil()` keeps the Service Worker alive until the write is done,
        // even if the page was already answered from the cache (time out).
        event.waitUntil(
            networkResponse
            .then(responseFromFetch => {
                // Only cache successful responses (no 404s, 500s etc.)
                if (responseFromFetch.ok) {
                    return addToCache(pagesCacheName, request, responseFromFetch.clone())
                    .catch(error => {
                        console.error('Failed to cache page:', error);
                    });
                }
            })
            .catch(() => {
                // Network failures are handled by `respondWith()` below
            })
        );

        event.respondWith(
            new Promise(resolveWithResponse => {
                const timer = setTimeout(() => {
                    // Time out: CACHE
                    retrieveFromCache
                    .then(responseFromCache => {
                        if (responseFromCache) {
                            resolveWithResponse(responseFromCache);
                        }
                    });
                }, timeout);

                networkResponse
                .then(responseFromFetch => {
                    // NETWORK
                    clearTimeout(timer);
                    resolveWithResponse(responseFromFetch);
                })
                .catch(fetchError => {
                    clearTimeout(timer);
                    console.error(fetchError);
                    // CACHE or FALLBACK
                    caches.match(request)
                    .then(responseFromCache => {
                        resolveWithResponse(
                            responseFromCache || caches.match(offlinePage)
                        );
                    });
                });
            })
        );
        return;
    }

    // For non-HTML requests, look in the cache first, fall back to the network
    event.respondWith(
        caches.match(request)
        .then(responseFromCache => {
            // CACHE
            return responseFromCache || fetch(request)
            .then(responseFromFetch => {
                // NETWORK
                // If the request is for an image, stash a copy of this image in the images cache
                if (isImage && responseFromFetch.ok) {
                    event.waitUntil(
                        addToCache(imagesCacheName, request, responseFromFetch.clone())
                        .catch(error => {
                            console.error('Failed to cache image:', error);
                        })
                    );
                }
                return responseFromFetch;
            })
            .catch(fetchError => {
                console.error(fetchError);
                // FALLBACK
                // show an offline placeholder for images
                if (isImage) {
                    return new Response('<svg role="img" aria-labelledby="offline-title" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg"><title id="offline-title">Offline</title><g fill="none" fill-rule="evenodd"><path fill="#3e5156" d="M0 0h400v300H0z"/><text fill="#d5dee0" font-family="Helvetica Neue,Arial,Helvetica,sans-serif" font-size="72" font-weight="bold"><tspan x="93" y="172">Offline</tspan></text></g></svg>', {headers: {'Content-Type': 'image/svg+xml', 'Cache-Control': 'no-store'}});
                }
                // No offline fallback for non-image assets (CSS, JS, fonts, etc.) —
                // `Response.error()` gives `respondWith()` a proper "network error"
                // Response so the browser treats this as an ordinary failed request,
                // instead of `undefined` (which `respondWith()` cannot use and
                // throws "Failed to convert value to 'Response'" for).
                return Response.error();
            });
        })
    );
});
