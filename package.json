{
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "name": "brootaylor.com",
  "version": "3.0.0",
  "description": "Version 3 of my personal website, brootaylor.com.",
  "keywords": [
    "personal-website",
    "blog"
  ],
  "author": {
    "name": "Bruce Taylor",
    "url": "https://brootaylor.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brootaylor/brootaylor-v3.git"
  },
  "homepage": "https://github.com/brootaylor/brootaylor-v3#readme",
  "bugs": {
    "url": "https://github.com/brootaylor/brootaylor-v3/issues"
  },
  "scripts": {
    "scan:locks": "node scan-locks.mjs",
    "scan:locks:json": "node scan-locks.mjs --json",
    "scan:locks:explain": "node scan-locks.mjs --explain",
    "scan:locks:ci": "node scan-locks.mjs --json --explain",
    "scan:locks:summary": "node scan-locks.mjs --json | node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);console.log(j.summary||'No summary');process.exit(j.ok?0:1);}catch(e){console.error('Invalid JSON from scan');process.exit(1);}})\"",
    "scan:locks:review-check": "node check-locklist-review.mjs",
    "clean": "rimraf dist && mkdir dist",
    "prebuild": "npm run scan:locks && npm run scan:locks:review-check && npm run audit:npm && npm run clean && echo 'Scanning lockfiles + npm audit & getting rid of old stuff first 🔥'",
    "lint:scripts": "eslint .",
    "lint:markdown": "markdownlint src/**/*.md",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "postcss": "postcss --map --no-map -r dist/styles/*.css --config config/postcss.config.js",
    "sass:tokens": "rimraf src/styles/tokens/*.scss && json-to-scss 'tokens/*.json' 'src/styles/tokens/_tokens.scss'",
    "sass:dev": "npm run sass:tokens && npx sass --style=expanded --no-source-map --watch src:dist",
    "sass:prod": "npm run sass:tokens && npx sass --style=compressed src:dist",
    "dev:files": "eleventy --serve --quiet",
    "dev:styles": "npm run sass:dev",
    "dev:scripts": "cross-env rollup -c config/rollup.config.mjs --watch",
    "dev": "run-p dev:*",
    "build:files": "eleventy --quiet",
    "build:styles": "npm run sass:prod",
    "build:scripts": "rollup -c config/rollup.config.mjs",
    "build": "run-s build:styles build:scripts build:files",
    "deploy:build": "cross-env NODE_ENV=production npm run build",
    "postbuild": "npm run postcss",
    "prenetlify-build": "npm run scan:locks:review-check && npm run scan:locks:ci && echo '✅ Netlify prebuild: lockfile scan passed'",
    "netlify-build": "ntl build",
    "netlify-dev": "ntl dev",
    "netlify-dev:debug": "ntl dev --debug",
    "netlify-dev:live": "ntl dev --live",
    "netlify-deploy:draft": "ntl deploy --build",
    "netlify-deploy:production": "ntl deploy --prod --build",
    "audit:browser-support": "npx browserslist && echo '🔆 Modify .browserslistrc if and when browser support changes. 🔆'",
    "audit:accessibility": "npx pa11y-ci --config ./config/pa11y.json > ./audits/accessibility_report/brootaylor-accessibility-results.md",
    "audit:performance": "lighthouse https://brootaylor.com --budget-path=config/performance-budget.json --output-path=./audits/lighthouse_report/brootaylor-performance-results.html --view",
    "audit:vulnerabilities": "npx is-website-vulnerable https://brootaylor.com",
    "audit:npm-local": "ncu",
    "audit:npm-global": "ncu -g",
    "audit:npm": "npm audit --audit-level=high || true",
    "debug": "DEBUG=* npx eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@sindresorhus/slugify": "^3.0.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.0",
    "html-minifier-terser": "^7.2.0",
    "json-to-scss": "^1.6.2",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "normalize-url": "^9.0.1",
    "npm-run-all": "^4.1.5",
    "object-fit-images": "^3.2.4",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-preset-env": "^11.5.3",
    "rimraf": "^6.1.3",
    "rollup": "4.63.3",
    "sass": "^1.104.1"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "markdownlint-cli": "^0.49.1",
    "netlify-cli": "27.8.0",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "ansi-styles": "^6.2.3",
    "debug": "^4.4.3",
    "supports-color": "^10.2.2",
    "wrap-ansi": "^9.0.2",
    "slice-ansi": "^7.1.2",
    "color": "^5.0.2",
    "color-convert": "3.1.0",
    "color-name": "2.0.0",
    "color-string": "2.1.0",
    "simple-swizzle": "0.2.2",
    "is-arrayish": "0.3.2",
    "supports-hyperlinks": "^4.1.2",
    "has-ansi": "^6.0.2",
    "chalk-template": "^1.1.2",
    "backslash": "0.2.0",
    "@ctrl/tinycolor": "^4.2.0",
    "json-to-scss": {
      "chalk": "4.1.2",
      "ansi-styles": "4.3.0",
      "supports-color": "7.2.0",
      "string-width": "4.2.3",
      "strip-ansi": "6.0.1",
      "ansi-regex": "5.0.1"
    },
    "npm-run-all": {
      "chalk": "^5.6.2"
    },
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.3",
    "keyv": "5.6.0",
    "cacheable": "2.5.0",
    "flat-cache": "6.1.23",
    "file-entry-cache": "11.1.5",
    "@cacheable/utils": "2.5.0",
    "@cacheable/memory": "2.2.0"
  },
  "engines": {
    "node": "^24.18.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "unix-dgram@2.0.7": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.6.0": true,
    "netlify-cli@27.8.0": true,
    "fsevents@2.3.3": true
  }
}
