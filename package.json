{
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "name": "brootaylor.com",
  "version": "3.1.0",
  "description": "Version 3 of my personal website, brootaylor.com.",
  "keywords": [
    "personal-website",
    "blog"
  ],
  "author": {
    "name": "Bruce Taylor",
    "url": "https://brootaylor.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brootaylor/brootaylor-v3.git"
  },
  "homepage": "https://github.com/brootaylor/brootaylor-v3#readme",
  "bugs": {
    "url": "https://github.com/brootaylor/brootaylor-v3/issues"
  },
  "scripts": {
    "clean": "rimraf dist && mkdir dist",
    "prebuild": "npm run audit:npm && npm run clean && echo 'Running npm audit & getting rid of old stuff first 🔥'",
    "lint:scripts": "eslint .",
    "lint:markdown": "markdownlint \"src/**/*.md\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "postcss": "postcss --no-map -r dist/styles/*.css --config config/postcss.config.js",
    "sass:tokens": "rimraf src/styles/tokens/*.scss && json-to-scss 'tokens/*.json' 'src/styles/tokens/_tokens.scss'",
    "sass:dev": "npm run sass:tokens && npx sass --style=expanded --no-source-map --watch src:dist",
    "sass:prod": "npm run sass:tokens && npx sass --style=compressed src/styles/main.scss:dist/styles/main.css",
    "dev:files": "eleventy --serve --quiet",
    "dev:styles": "npm run sass:dev",
    "dev:scripts": "rollup -c config/rollup.config.mjs --watch",
    "dev": "run-p dev:*",
    "build:files": "eleventy --quiet",
    "build:styles": "npm run sass:prod && npm run postcss",
    "build:scripts": "rollup -c config/rollup.config.mjs",
    "build": "run-s build:styles build:scripts build:files",
    "deploy:build": "cross-env NODE_ENV=production npm run build",
    "netlify-build": "ntl build",
    "netlify-dev": "ntl dev",
    "netlify-dev:debug": "ntl dev --debug",
    "netlify-dev:live": "ntl dev --live",
    "netlify-deploy:draft": "ntl deploy --build",
    "netlify-deploy:production": "ntl deploy --prod",
    "audit:browser-support": "npx browserslist && echo '🔆 Modify .browserslistrc if and when browser support changes. 🔆'",
    "audit:accessibility": "npx pa11y-ci --config ./config/pa11y.json > ./audits/accessibility_report/brootaylor-accessibility-results.md",
    "audit:lighthouse:build": "node config/lighthouse.mjs",
    "audit:lighthouse:live": "node config/lighthouse.mjs --live --view",
    "audit:vulnerabilities": "npx is-website-vulnerable https://brootaylor.com",
    "audit:npm-local": "npx npm-check-updates",
    "audit:npm-global": "npx npm-check-updates -g",
    "audit:npm": "npm audit --include=dev --audit-level=high || true",
    "debug": "DEBUG=* npx eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-fetch": "^6.0.1",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@puppeteer/browsers": "^3.2.6",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@sindresorhus/slugify": "^4.0.1",
    "chrome-launcher": "^1.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "html-minifier-terser": "^7.2.0",
    "json-to-scss": "^1.6.2",
    "lighthouse": "^13.6.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-attrs": "^5.0.1",
    "normalize-url": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-preset-env": "^11.6.2",
    "rimraf": "^6.1.4",
    "rollup": "4.68.2",
    "sass": "^1.108.1"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "markdownlint-cli": "^0.50.0",
    "netlify-cli": "27.16.3",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "unix-dgram@2.0.7": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "netlify-cli@27.16.3": true
  }
}
